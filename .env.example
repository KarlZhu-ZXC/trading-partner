# Trading Partner configuration (safe defaults only — never put real secrets here)
# Copy to .env and adjust locally. .env is gitignored.

# =============================================================================
# 1. USER INPUTS — REQUIRED
# =============================================================================
# None. Trading Partner starts without broker accounts, paid fallbacks, or API keys.

# =============================================================================
# 2. USER INPUTS — OPTIONAL INTEGRATIONS AND PREFERENCES
# =============================================================================
# Every integration in this section is optional. A field described as "required
# when enabled" is required only after you choose to enable that integration.

# SEC filings and reported fundamentals
# Required when SEC_EDGAR_ENABLED=true. Use: CompanyName Contact@email
SEC_EDGAR_ENABLED=true
SEC_USER_AGENT=

# FRED / ALFRED macro data
# Required when FRED_ENABLED=true.
FRED_ENABLED=true
FRED_API_KEY=

# Holdings sources — JSON array; zero, one, or multiple values are allowed.
HOLDINGS_SOURCES=[]  # SCHWAB | MOOMOO | MANUAL_CSV

# Moomoo read-only accounts
# MOOMOO_ACCOUNT_IDS is required when HOLDINGS_SOURCES contains MOOMOO. Use account
# IDs only; never add trade unlock credentials. Host/port point to local OpenD.
MOOMOO_ACCOUNT_IDS=
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
# Currency used by OpenD for cash, buying power, NAV, and margin totals.
MOOMOO_ACCOUNT_BASE_CURRENCY=USD
# Optional US community-attention ranking from OpenD 10.9+.
MOOMOO_COMMUNITY_HEAT_ENABLED=false
MOOMOO_COMMUNITY_HEAT_LIMIT=20

# Charles Schwab read-only accounts
# Credentials and hashes are required when HOLDINGS_SOURCES contains SCHWAB.
# schwab-py creates and owns the rotating token file; never copy a plugin token.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_ACCOUNT_HASHES=
SCHWAB_REDIRECT_URI=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=data/secrets/schwab_tokens.json

# Manual holdings account
# The path is required when HOLDINGS_SOURCES contains MANUAL_CSV.
MANUAL_HOLDINGS_CSV_PATH=

# Watchlist source — choose exactly one: MOOMOO or MANUAL_CSV
# MANUAL_WATCHLIST_CSV_PATH is required only for MANUAL_CSV.
# Moomoo Watchlist uses local OpenD but does not require MOOMOO in
# HOLDINGS_SOURCES or any account IDs.
WATCHLIST_SOURCE=MOOMOO  # MOOMOO | MANUAL_CSV (exactly one)
MANUAL_WATCHLIST_CSV_PATH=

# Telegram delivery for deterministic notifications, including Monitor alerts
# and explicitly authorized manual text. Create the bot with @BotFather, send it
# one message, then fill the token and numeric chat id. PROVIDER_PROXY_URL also
# applies to Telegram when configured.
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional forum-topic id for a Telegram supergroup; leave blank for direct chat.
TELEGRAM_MESSAGE_THREAD_ID=
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_TTL_HOURS=24
NOTIFICATION_BATCH_SIZE=20

# Moomoo public-feed sentiment (deterministic; no Skill or runtime LLM)
MOOMOO_SENTIMENT_ENABLED=true

# Reddit sentiment: anonymous RSS plus optional paid Apify fallback
REDDIT_ENABLED=true
REDDIT_SUBREDDITS=wallstreetbets,stocks,investing
REDDIT_APIFY_ENABLED=false
REDDIT_APIFY_SUBREDDITS=stocks,investing,securityanalysis,valueinvesting,wallstreetbets,shortsqueeze
# Shared Apify credential. Required only for enabled Reddit or IG browser fallbacks.
APIFY_API_TOKEN=

# Optional current-only XAUUSD weekend fallback. This runs Apify Web Scraper
# against IG Weekend Gold, a separately formed CFD price—not spot or LBMA.
IG_WEEKEND_GOLD_ENABLED=false
IG_WEEKEND_GOLD_ACTOR_ID=apify/web-scraper
IG_WEEKEND_GOLD_CACHE_TTL_SECONDS=600
IG_WEEKEND_GOLD_MAX_CHARGE_USD=0.03
IG_WEEKEND_GOLD_TIMEOUT_SECONDS=120

# Alpha Vantage is an optional fallback behind Yahoo Finance.
ALPHA_VANTAGE_ENABLED=true
# Comma-separated failover order; the active key changes only after an explicit rate limit.
ALPHA_VANTAGE_API_KEYS=

# Dukascopy Jetta data (OTC XAU/XAG and rolling copper CFD), following the
# current dukascopy-node bucket strategy. Keyless by default. DUKASCOPY_API_KEY
# is optional and used only by the legacy Trading Tools compatibility fallback.
DUKASCOPY_ENABLED=true
DUKASCOPY_API_KEY=

# Optional iWencai provider
IWENCAI_ENABLED=false
IWENCAI_API_KEY=

# Optional shared HTTP(S) proxy for CME, DCE, Dukascopy and Polymarket. If unset,
# these providers connect directly. The URL may contain credentials, so a real
# value belongs only in .env.
PROVIDER_PROXY_URL=

POLYMARKET_ENABLED=true

# Watchlist preference
WATCHLIST_DEFAULT_GROUP=Favorites  # applies to both MOOMOO and MANUAL_CSV

# =============================================================================
# 3. SAFE RUNTIME DEFAULTS — USUALLY NO USER EDIT IS REQUIRED
# =============================================================================

# Application
APP_NAME=trading-partner
APP_ENV=development
LOG_LEVEL=INFO
MCP_SERVER_NAME=trading-partner
DEFAULT_TIMEZONE=UTC
PROVIDER_TIMEOUT_SECONDS=30.0

# Database and provider routing
DATABASE_URL=sqlite:///data/trading_partner.db
VENDOR_CHAIN_PATH=config/vendor_chains.default.yaml

# Provider timeouts
PROVIDER_TIMEOUT_DEFAULT_SECONDS=30.0
PROVIDER_TIMEOUT_MARKET_SECONDS=15.0
PROVIDER_TIMEOUT_US_BREADTH_SECONDS=30.0
HTTP_MAX_RESPONSE_BYTES=20000000

# Same-provider retry
PROVIDER_RETRY_MAX_ATTEMPTS=2
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.05
PROVIDER_RETRY_MAX_DELAY_SECONDS=1.0
PROVIDER_RATE_LIMIT_MAX_WAIT_SECONDS=5
AUTH_FAILURE_FALLBACK=false

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT_SECONDS=60.0
CIRCUIT_HALF_OPEN_MAX_CALLS=1
ENABLE_CIRCUIT_BREAKER=true

# Core provider cache TTLs (seconds)
CACHE_TTL_MARKET_QUOTE_SECONDS=5
CACHE_TTL_MARKET_SNAPSHOT_SECONDS=30
CACHE_TTL_MARKET_OHLCV_SECONDS=300
CACHE_TTL_INSTRUMENT_MASTER_SECONDS=86400
CACHE_TTL_DEFAULT_SECONDS=300
ENABLE_PROVIDER_CACHE=true

# Stale-data guard and freshness thresholds
STALE_GUARD_MAX_AGE_SECONDS=86400
STALE_GUARD_RESPECT_SESSION=true
STALE_GUARD_ALLOW_CLOSED_LAST_BAR=true
FRESHNESS_MAX_FRESH_SECONDS=60
FRESHNESS_MAX_DELAYED_SECONDS=900

# A-share providers and freshness
EASTMONEY_ENABLED=true
EASTMONEY_MIN_INTERVAL_SECONDS=1.0
EASTMONEY_JITTER_SECONDS=0.25
TENCENT_ENABLED=true
CNINFO_ENABLED=true
NAHS_ENABLED=true
SINA_ENABLED=true
THS_ENABLED=true
CLS_ENABLED=true
IWENCAI_BASE_URL=https://openapi.iwencai.com
A_SHARE_CURRENT_WINDOW_SECONDS=300
A_SHARE_MAX_FRESH_SECONDS=30
A_SHARE_MAX_DELAYED_SECONDS=900

# US market providers and freshness
YFINANCE_ENABLED=true
CACHE_TTL_US_MARKET_BREADTH_SECONDS=900
US_CURRENT_WINDOW_SECONDS=300
US_MAX_FRESH_SECONDS=30
US_MAX_DELAYED_SECONDS=900

# US research
US_RESEARCH_CURRENT_WINDOW_SECONDS=21600

# Reddit / Apify behavior
REDDIT_APIFY_ACTOR_ID=harshmaur/reddit-scraper
REDDIT_APIFY_LOOKBACK_DAYS_BY_SUBREDDIT=stocks:7,investing:14,securityanalysis:30,valueinvesting:30,wallstreetbets:3,shortsqueeze:2
REDDIT_APIFY_MAX_CHARGE_USD=0.20
REDDIT_USER_AGENT=TradingPartner/1.0
REDDIT_MIN_INTERVAL_SECONDS=6.0
REDDIT_CACHE_TTL_SECONDS=3600
REDDIT_COOLDOWN_DEFAULT_SECONDS=900
REDDIT_COOLDOWN_MAX_SECONDS=3600

# Scheduled post-market synchronization
POST_MARKET_SYNC_DELAY_MINUTES=10
POST_MARKET_SYNC_LOCK_PATH=data/locks/post_market_sync.lock

# Provider cache TTLs by data category (seconds)
CACHE_TTL_MARKET_STRUCTURE_SECONDS=5
CACHE_TTL_CAPITAL_SECONDS=30
CACHE_TTL_LIMIT_UP_SECONDS=30
CACHE_TTL_OPTIONS_SECONDS=15
CACHE_TTL_SENTIMENT_SECONDS=30
CACHE_TTL_INTERACTIVE_QA_SECONDS=300
CACHE_TTL_RESEARCH_REPORTS_SECONDS=3600
CACHE_TTL_CORPORATE_ACTIONS_SECONDS=21600
CACHE_TTL_NEWS_SECONDS=300
CACHE_TTL_ANNOUNCEMENTS_SECONDS=300
CACHE_TTL_FUNDAMENTALS_SECONDS=21600
CACHE_TTL_FINANCIAL_STATEMENTS_SECONDS=21600
CACHE_TTL_FILINGS_SECONDS=3600
CACHE_TTL_INSIDER_ACTIVITY_SECONDS=3600
